{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEI bootstrap manifest (simulation)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "runtime",
              "package_manager",
              "tool"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "kind",
          "depends_on"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "note",
    "components"
  ]
}
