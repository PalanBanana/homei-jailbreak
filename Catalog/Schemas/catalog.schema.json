{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEI package catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "compatibility": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "product_type": {
                  "type": "string"
                },
                "product_version": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "supported",
                    "unsupported",
                    "partially_supported",
                    "not_established",
                    "unknown"
                  ]
                }
              },
              "required": [
                "product_type",
                "product_version",
                "status"
              ]
            }
          },
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "const": "sha256"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": [
              "algorithm",
              "digest",
              "verified"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fixture": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "summary",
          "source_id",
          "license",
          "compatibility",
          "integrity",
          "dependencies",
          "fixture"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "note",
    "packages"
  ]
}
