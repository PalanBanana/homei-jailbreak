{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEI virtual research lab state",
  "description": "Sanitized snapshot exported by the host controller. It holds no path, no device identifier and no claim that a virtual machine for the target booted unless an experiment records it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_on",
    "target",
    "host",
    "backends",
    "firmware",
    "ghidra",
    "guest",
    "fidelity",
    "experiments",
    "correlations",
    "evidence",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_id",
        "commercial_model",
        "product_type",
        "soc",
        "cpu",
        "board",
        "cpid",
        "bdid",
        "architecture",
        "os_version",
        "build_version",
        "vm_status",
        "hardware_fidelity",
        "provenance",
        "discrepancies",
        "checked_on"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "target_id": {
          "type": "string"
        },
        "commercial_model": {
          "const": "iPhone 15 Pro Max"
        },
        "product_type": {
          "const": "iPhone16,2"
        },
        "soc": {
          "const": "Apple A17 Pro"
        },
        "cpu": {
          "const": "t8130"
        },
        "board": {
          "const": "D84AP"
        },
        "cpid": {
          "const": "0x8130"
        },
        "bdid": {
          "const": "0x06"
        },
        "architecture": {
          "const": "arm64e"
        },
        "os_version": {
          "const": "27.0.1"
        },
        "build_version": {
          "const": "24A446"
        },
        "vm_status": {
          "enum": [
            "NOT_TESTED",
            "REFERENCE_DEVICE_ONLY"
          ]
        },
        "hardware_fidelity": {
          "enum": [
            "EXACT",
            "PARTIAL",
            "APPROXIMATE",
            "UNSUPPORTED",
            "UNVERIFIED"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "kind",
              "confidence",
              "tracker_claim_ids",
              "note"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "primary",
                  "secondary",
                  "reference"
                ]
              },
              "confidence": {
                "enum": [
                  "verified",
                  "partially_verified",
                  "unverified"
                ]
              },
              "tracker_claim_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          },
          "minProperties": 10
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "summary",
              "tracker_claim_ids"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "tracker_claim_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "checked_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "architecture",
        "qemu_version",
        "qemu_accelerators",
        "kvm_device_present",
        "ghidra_version",
        "memory_total_gib",
        "memory_available_gib"
      ],
      "properties": {
        "distribution": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "qemu_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "qemu_accelerators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kvm_device_present": {
          "type": "boolean"
        },
        "ghidra_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory_total_gib": {
          "type": "integer",
          "minimum": 0
        },
        "memory_available_gib": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "available",
          "optional",
          "vm_status",
          "blockers",
          "upstream_commit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "optional": {
            "type": "boolean"
          },
          "vm_status": {
            "enum": [
              "EXACT_TARGET_VERIFIED",
              "TARGET_KERNEL_BOOTED_HARDWARE_UNVERIFIED",
              "PARTIAL_DARWIN_GUEST",
              "REFERENCE_DEVICE_ONLY",
              "UNSUPPORTED_TARGET",
              "BLOCKED_BY_MISSING_FIRMWARE",
              "BLOCKED_BY_MISSING_QEMU_FEATURE",
              "BOOT_FAILURE",
              "NOT_TESTED"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "upstream_commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "firmware": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bytes",
          "sha256",
          "format",
          "source_build",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "format": {
            "type": "string"
          },
          "source_build": {
            "const": "24A446"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "ghidra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ghidra_version",
        "project_name",
        "project_present",
        "program",
        "firmware_sha256",
        "architecture",
        "import_status",
        "function_count",
        "fileset_entries",
        "fileset_entries_covered",
        "symbol_match_basis_points",
        "import_errors",
        "last_analysis_date",
        "source_reference",
        "confidence"
      ],
      "properties": {
        "ghidra_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_name": {
          "type": "string"
        },
        "project_present": {
          "type": "boolean"
        },
        "program": {
          "type": "string"
        },
        "firmware_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture": {
          "type": "string"
        },
        "import_status": {
          "type": "string"
        },
        "function_count": {
          "type": "integer",
          "minimum": 0
        },
        "fileset_entries": {
          "type": "integer",
          "minimum": 0
        },
        "fileset_entries_covered": {
          "type": "integer",
          "minimum": 0
        },
        "symbol_match_basis_points": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "import_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_analysis_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_reference": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        }
      }
    },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_scope",
        "overlay_present",
        "base_image_sha256",
        "snapshots",
        "vm_running",
        "bootstrap_version",
        "bootstrap_state",
        "packages",
        "transactions"
      ],
      "properties": {
        "filesystem_scope": {
          "type": "string"
        },
        "overlay_present": {
          "type": "boolean"
        },
        "base_image_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshots": {
          "type": "integer",
          "minimum": 0
        },
        "vm_running": {
          "type": "boolean"
        },
        "bootstrap_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bootstrap_state": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "provenance",
              "signature",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "provenance": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              },
              "files": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "transactions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "firmware_identity",
        "firmware",
        "hardware",
        "functional",
        "vm_status",
        "hardware_fidelity",
        "notes"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "firmware_identity": {
          "enum": [
            "EXACT_REFERENCE_MATCH",
            "BUILD_MISMATCH",
            "MODEL_MISMATCH",
            "NOT_ESTABLISHED"
          ]
        },
        "firmware": {
          "enum": [
            "EXACT",
            "PARTIAL",
            "APPROXIMATE",
            "UNSUPPORTED",
            "UNVERIFIED",
            "NOT_TESTED"
          ]
        },
        "hardware": {
          "enum": [
            "EXACT",
            "PARTIAL",
            "APPROXIMATE",
            "UNSUPPORTED",
            "UNVERIFIED",
            "NOT_TESTED"
          ]
        },
        "functional": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "EXACT",
              "PARTIAL",
              "APPROXIMATE",
              "UNSUPPORTED",
              "UNVERIFIED",
              "NOT_TESTED"
            ]
          }
        },
        "vm_status": {
          "enum": [
            "EXACT_TARGET_VERIFIED",
            "TARGET_KERNEL_BOOTED_HARDWARE_UNVERIFIED",
            "PARTIAL_DARWIN_GUEST",
            "REFERENCE_DEVICE_ONLY",
            "UNSUPPORTED_TARGET",
            "BLOCKED_BY_MISSING_FIRMWARE",
            "BLOCKED_BY_MISSING_QEMU_FEATURE",
            "BOOT_FAILURE",
            "NOT_TESTED"
          ]
        },
        "hardware_fidelity": {
          "enum": [
            "EXACT",
            "PARTIAL",
            "APPROXIMATE",
            "UNSUPPORTED",
            "UNVERIFIED"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "kind",
          "target",
          "backend",
          "guest_os_build",
          "firmware_artifacts",
          "config_sha256",
          "snapshot_id",
          "inputs",
          "timestamp",
          "status",
          "boot_outcome",
          "result",
          "log_refs",
          "limitations",
          "reproducible"
        ],
        "properties": {
          "experiment_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "product_type",
              "soc",
              "board",
              "build_version"
            ],
            "properties": {
              "target_id": {
                "type": "string"
              },
              "product_type": {
                "type": "string"
              },
              "soc": {
                "type": "string"
              },
              "board": {
                "type": "string"
              },
              "build_version": {
                "type": "string"
              }
            }
          },
          "backend": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "version",
              "qemu_version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "none",
                  "mock",
                  "real"
                ]
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qemu_version": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "guest_os_build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "firmware_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "sha256"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "status": {
            "enum": [
              "PLANNED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "INTERRUPTED",
              "INCONCLUSIVE",
              "NOT_REPRODUCIBLE"
            ]
          },
          "boot_outcome": {
            "anyOf": [
              {
                "enum": [
                  "not_attempted",
                  "booted",
                  "timeout",
                  "kernel_panic",
                  "interrupted",
                  "process_failed",
                  "incomplete_output"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "type": "string"
          },
          "log_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "sha256"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reproducible": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "correlations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analysis_project",
          "firmware_sha256",
          "build_version",
          "experiment_id",
          "guest_identity",
          "config_sha256",
          "evidence_kind",
          "evidence_source",
          "confidence",
          "limitations"
        ],
        "properties": {
          "analysis_project": {
            "type": "string"
          },
          "firmware_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "build_version": {
            "type": "string"
          },
          "experiment_id": {
            "type": "string"
          },
          "guest_identity": {
            "type": "string"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_kind": {
            "enum": [
              "static_observation",
              "decompiled_interpretation",
              "emulator_observation",
              "reproduced_behavior",
              "hypothesis",
              "unknown"
            ]
          },
          "evidence_source": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "title",
          "reference",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "limitation": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
