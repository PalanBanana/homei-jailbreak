{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PalanBanana/homei-jailbreak/Data/schemas/t8130-feasibility.schema.json",
  "title": "HOMEI T8130 feasibility matrix",
  "description": "Output of `homei-lab feasibility`. Statuses are derived from stated decisions. No exact target VM is claimed without boot evidence.",
  "type": "object",
  "required": ["schema_version", "target", "generated_on", "analysis_analysed_on", "exact_target_vm", "components"],
  "additionalProperties": false,
  "$defs": {
    "status": { "enum": ["VERIFIED", "PARTIAL", "BLOCKED", "UNSUPPORTED", "UNVERIFIED"] },
    "confidence": { "enum": ["target", "manifest", "inferred", "unknown"] }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "target": { "const": "iPhone16,2 / D84AP / T8130 / iOS 27.0.1 (24A446)" },
    "generated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "analysis_analysed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "exact_target_vm": {
      "type": "object",
      "required": ["status", "statement"],
      "properties": {
        "status": { "const": "NOT_ESTABLISHED" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "title", "question", "status", "basis", "decisions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "title": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "basis": { "type": "string", "minLength": 1 },
          "decisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["statement", "source", "evidence_type", "confidence", "last_verified", "limitation"],
              "additionalProperties": false,
              "properties": {
                "statement": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "evidence_type": { "type": "string", "minLength": 1 },
                "confidence": { "$ref": "#/$defs/confidence" },
                "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "limitation": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
