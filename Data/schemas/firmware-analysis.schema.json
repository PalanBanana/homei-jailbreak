{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PalanBanana/homei-jailbreak/Data/schemas/firmware-analysis.schema.json",
  "title": "HOMEI T8130 firmware analysis bundle",
  "description": "Output of `homei-lab analyze`. Static, read-only. Every file is named relative to the input root; no local path is recorded.",
  "type": "object",
  "required": ["schema_version", "target", "identity_checks", "manifest_identities", "provenance", "archive", "components", "summary", "security", "kernelcache", "devicetree", "ghidra", "claims"],
  "additionalProperties": false,
  "$defs": {
    "availability": {
      "enum": ["analysed", "container_only", "encrypted", "unsupported", "unavailable", "missing", "no_manifest_path"]
    },
    "confidence": {
      "enum": ["target", "manifest", "inferred", "unknown"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "target": {
      "type": "object",
      "required": ["label", "product_type", "board_config", "chip", "architecture", "product_version", "build", "erase_variant"],
      "properties": {
        "label": { "const": "iPhone16,2 / D84AP / T8130 / iOS 27.0.1 (24A446)" },
        "product_type": { "const": "iPhone16,2" },
        "board_config": { "const": "D84AP" },
        "chip": { "const": "T8130" },
        "architecture": { "const": "arm64e" },
        "product_version": { "const": "27.0.1" },
        "build": { "const": "24A446" },
        "erase_variant": { "const": "Customer Erase Install (IPSW)" }
      }
    },
    "identity_checks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "expected", "observed", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "manifest_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant", "restore_behavior", "board_id_hex", "chip_id_hex", "device_class", "component_count"],
        "properties": {
          "variant": { "type": "string" },
          "restore_behavior": { "type": "string" },
          "board_id_hex": { "type": "string" },
          "chip_id_hex": { "type": "string" },
          "device_class": { "type": "string" },
          "component_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["tool", "tool_version", "schema_version", "analysed_on", "inputs", "external_steps"],
      "properties": {
        "tool": { "const": "homei-lab analyze" },
        "tool_version": { "type": "string" },
        "schema_version": { "const": 1 },
        "analysed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "file_name", "bytes", "sha256"],
            "properties": {
              "role": { "type": "string" },
              "file_name": { "type": "string", "pattern": "^[^/\\\\]+$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "external_steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "archive": {
      "type": "object",
      "required": ["entry_count", "stored_entries", "deflated_entries", "uncompressed_total_bytes", "entries", "erase_components_missing_from_archive"],
      "properties": {
        "entry_count": { "type": "integer", "minimum": 1 },
        "stored_entries": { "type": "integer", "minimum": 0 },
        "deflated_entries": { "type": "integer", "minimum": 0 },
        "uncompressed_total_bytes": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "method", "compressed_bytes", "uncompressed_bytes"],
            "properties": {
              "name": { "type": "string" },
              "method": { "type": "integer" },
              "compressed_bytes": { "type": "integer", "minimum": 0 },
              "uncompressed_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "erase_components_missing_from_archive": { "type": "array", "items": { "type": "string" } }
      }
    },
    "components": {
      "type": "array",
      "minItems": 97,
      "maxItems": 97,
      "items": {
        "type": "object",
        "required": ["name", "path", "trusted", "in_archive", "availability", "container", "manifest_digest_matches"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] },
          "trusted": { "type": "boolean" },
          "in_archive": { "type": "boolean" },
          "archive_uncompressed_bytes": { "type": ["integer", "null"] },
          "local_file": { "type": ["string", "null"], "pattern": "^[^/\\\\]" },
          "local_bytes": { "type": ["integer", "null"] },
          "local_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "manifest_digest_matches": { "type": ["boolean", "null"] },
          "container": { "type": ["object", "null"] },
          "availability": { "$ref": "#/$defs/availability" },
          "payload_file": { "type": ["string", "null"] },
          "payload_bytes": { "type": ["integer", "null"] },
          "payload_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["erase_components", "analysed", "container_only", "encrypted", "unsupported", "unavailable", "missing", "no_manifest_path"],
      "properties": {
        "erase_components": { "const": 97 },
        "analysed": { "type": "integer", "minimum": 0 },
        "container_only": { "type": "integer", "minimum": 0 },
        "encrypted": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "no_manifest_path": { "type": "integer", "minimum": 0 }
      }
    },
    "security": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "component", "availability", "encryption", "payload_compression"],
        "properties": {
          "role": { "type": "string" },
          "component": { "type": "string" },
          "availability": { "$ref": "#/$defs/availability" },
          "encryption": { "enum": ["keybag", "aea_external_keys", "not_encrypted", "not_applicable"] },
          "payload_compression": { "enum": ["lzfse", "lzvn", "complzss", "none", null] }
        }
      }
    },
    "kernelcache": {
      "type": ["object", "null"],
      "required": ["payload_file", "payload_bytes", "macho", "fileset_entry_count", "fileset_entries"],
      "properties": {
        "payload_file": { "type": "string", "pattern": "^[^/\\\\]" },
        "payload_bytes": { "type": "integer", "minimum": 1 },
        "fileset_entry_count": { "type": "integer", "minimum": 0 },
        "fileset_entries": { "type": "array", "items": { "type": "string" } },
        "xnu_version": { "type": ["string", "null"] },
        "configuration_token": { "type": ["string", "null"] }
      }
    },
    "devicetree": {
      "type": ["object", "null"],
      "required": ["payload_file", "payload_bytes", "payload_sha256", "node_count", "root_compatible", "arm_io_compatible", "arm_io_ranges", "aic", "pmgr", "aic_timebase_reg"],
      "properties": {
        "payload_file": { "type": "string", "pattern": "^[^/\\\\]" },
        "node_count": { "type": "integer", "minimum": 1 },
        "root_compatible": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "aic": {
          "type": ["object", "null"],
          "required": ["path", "compatible", "interrupt_cells", "reg", "reg_names_present", "translated_base_hex"],
          "properties": {
            "path": { "const": "/arm-io/aic" },
            "compatible": { "type": "array", "items": { "type": "string" } },
            "interrupt_cells": { "type": ["integer", "null"] },
            "reg_names_present": { "type": "boolean" },
            "translated_base_hex": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]+$" }
          }
        },
        "pmgr": {
          "type": ["object", "null"],
          "required": ["path", "compatible", "reg_windows", "power_domain_names", "interrupts"],
          "properties": {
            "path": { "const": "/arm-io/pmgr" },
            "compatible": { "type": "array", "items": { "type": "string" } },
            "power_domain_names": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "ghidra": {
      "type": ["object", "null"],
      "required": ["project_name", "project_file_bytes", "project_file_state", "names", "function_count", "export_present"],
      "properties": {
        "project_file_state": { "enum": ["empty", "present"] },
        "function_count": { "type": "null" },
        "export_present": { "const": false },
        "names": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "present_in_index"],
            "properties": { "name": { "type": "string" }, "present_in_index": { "type": "boolean" } }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "confidence", "source", "limitation"],
        "properties": {
          "id": { "type": "string", "pattern": "^FA-\\d{3}$" },
          "statement": { "type": "string", "minLength": 1 },
          "confidence": { "$ref": "#/$defs/confidence" },
          "source": { "type": "string", "minLength": 1 },
          "limitation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
