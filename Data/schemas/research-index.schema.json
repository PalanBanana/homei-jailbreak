{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEI research index",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tracker_repository": {
      "type": "string",
      "pattern": "^https://"
    },
    "tracker_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "snapshot_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RF-\\d{3}$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "partially_verified",
              "unverified",
              "not_established",
              "contradicted"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^EV-\\d{3}$"
            }
          },
          "cve_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CVE-\\d{4}-\\d{4,}$"
            }
          },
          "hardware_scope": {
            "type": "string"
          },
          "firmware_scope": {
            "type": "string"
          },
          "tracker_claim_id": {
            "type": "string",
            "pattern": "^C-\\d{3}$"
          },
          "last_checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "evidence_ids",
          "cve_ids",
          "hardware_scope",
          "firmware_scope",
          "tracker_claim_id",
          "last_checked",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "tracker_repository",
    "tracker_commit",
    "snapshot_date",
    "note",
    "findings"
  ]
}
